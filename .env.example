PORT=3001
NODE_ENV=development

# Data stores
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amzpulse
REDIS_URL=redis://localhost:6379

# Auth and security
JWT_SECRET=replace-me-with-a-long-random-string
PASSWORD_RESET_TTL_MINUTES=60

# Provider (optional: leave blank to use mock data)
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_RATE_LIMIT_PER_MIN=60
ALLOW_MOCK_DATA=false

# Amazon Product Advertising API (official)
# Note: Amazon's official PA-API docs now point builders toward Creators API and note
# PA-API deprecation on April 30, 2026. These settings enable direct Amazon sync today.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_MARKETPLACE=www.amazon.com
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# Optional dashboard seed list for featured products
FEATURED_ASINS=

# API exposure (comma-separated frontend URLs, no trailing slash)
# The first entry is used for Stripe success/cancel redirects.
# Include both local dev and your deployed frontend host so CORS passes.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://viraladmedia.github.io
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CACHE_TTL_SECONDS=120
DB_FRESH_MS=300000

# Billing (optional: Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Background sync
ENABLE_METRICS_SYNC=false
SYNC_CRON=*/15 * * * *
SYNC_BATCH_SIZE=10
SYNC_CONCURRENCY=3

# Supabase (optional)
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
