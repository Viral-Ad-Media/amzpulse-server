PORT=3001
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -hex 32. Do not use the example value in production.
JWT_SECRET=
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BATCH_MAX=10
RATE_LIMIT_PREFIX=amzpulse:rl:
CACHE_TTL_SECONDS=120
DB_FRESH_MS=300000

# Server-only data providers (US marketplace). Configure at least one.
PRODUCT_DATA_PROVIDERS=spapi,keepa,rainforest
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_REGION=na
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER
KEEPA_API_KEY=
KEEPA_DOMAIN=1
RAINFOREST_API_KEY=
RAINFOREST_AMAZON_DOMAIN=amazon.com
# Optional operator HTTP adapter; overrides provider fallback when set.
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_RATE_LIMIT_PER_MIN=60
FEATURED_ASINS=
TRENDING_CATEGORY_URL=https://www.amazon.com/Best-Sellers-Electronics/zgbs/electronics
BESTSELLERS_CATEGORY_URL=https://www.amazon.com/Best-Sellers-Toys-Games/zgbs/toys-and-games

# Optional AI and required credentials when using password recovery.
GEMINI_API_KEY=
RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_TTL_MINUTES=60

# Optional Stripe billing; webhook is sent directly to /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Optional periodic paid refresh. Redis is required if enabled.
ENABLE_METRICS_SYNC=false
SYNC_CRON=*/15 * * * *
SYNC_BATCH_SIZE=10
SYNC_CONCURRENCY=3
